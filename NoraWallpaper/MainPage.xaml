<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Nythera.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Nythera"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" Width="450">
            <!-- Header -->
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock x:Name="AppTitle" Text="Nythera" Style="{ThemeResource TitleTextBlockStyle}" HorizontalAlignment="Center" FontWeight="Bold" />
                <TextBlock x:Name="AppDescription" Text="Select a video to set as your desktop background." Style="{ThemeResource BodyTextBlockStyle}" Foreground="Gray" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Video Selection Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button x:Name="BrowseVideoButton" Content="Browse Video" Click="BrowseVideo_Click" Width="160" />
                        <Button x:Name="ApplyButton" Content="Apply Wallpaper" Click="ApplyWallpaper_Click" Style="{ThemeResource AccentButtonStyle}" Width="160" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="No video selected." Foreground="Gray" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Settings Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="SettingsTitle" Text="Settings" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                    
                    <Grid RowSpacing="12" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Volume -->
                        <TextBlock x:Name="VolumeText" Text="Volume:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" />
                        <Slider x:Name="VolumeSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="0" ValueChanged="VolumeSlider_ValueChanged" />

                        <!-- Stretch Mode -->
                        <TextBlock x:Name="ChooseFitText" Text="Choose a fit:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" />
                        <ComboBox x:Name="StretchModeComboBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="StretchModeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Fill (Doldur)" Tag="UniformToFill" />
                            <ComboBoxItem Content="Fit (Sığdır)" Tag="Uniform" />
                            <ComboBoxItem Content="Stretch (Genişlet)" Tag="Fill" />
                            <ComboBoxItem Content="Center (Ortala)" Tag="None" />
                        </ComboBox>

                        <!-- Theme -->
                        <TextBlock x:Name="ThemeText" Text="Theme:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" />
                        <ComboBox x:Name="ThemeComboBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Dark" Tag="Dark" />
                            <ComboBoxItem Content="Light" Tag="Light" />
                            <ComboBoxItem Content="System" Tag="Default" />
                        </ComboBox>

                        <!-- Language -->
                        <TextBlock x:Name="LanguageText" Text="Language:" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" />
                        <ComboBox x:Name="LanguageComboBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem Content="English" Tag="en" />
                            <ComboBoxItem Content="Türkçe" Tag="tr" />
                        </ComboBox>
                    </Grid>
                    
                    <ToggleSwitch x:Name="StartupToggle" Header="Launch on Windows Startup" Toggled="StartupToggle_Toggled" />
                </StackPanel>
            </Border>

            <!-- Update Card -->
            <Border x:Name="UpdateContainer" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="UpdateStatusText" Text="A new version is available!" FontWeight="SemiBold" />
                    <Button x:Name="DownloadUpdateButton" Content="Download and Update" Style="{ThemeResource AccentButtonStyle}" Click="DownloadUpdateButton_Click" HorizontalAlignment="Stretch" />
                    <ProgressBar x:Name="UpdateProgressBar" Visibility="Collapsed" Minimum="0" Maximum="100" Value="0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
