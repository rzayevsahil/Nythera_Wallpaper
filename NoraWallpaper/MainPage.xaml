<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NoraWallpaper.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NoraWallpaper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        This is the main content area of your application.
        Add your UI elements here — for example, controls, layouts, and data-bound views.
        Use 'dotnet new winui-page' to create additional pages and navigate to them via
        the Frame in MainWindow (RootFrame).
    -->
    <Grid Padding="32">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="32" Width="400">
            <!-- Header -->
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="Nora Wallpaper" Style="{ThemeResource TitleTextBlockStyle}" HorizontalAlignment="Center" FontWeight="Bold" />
                <TextBlock Text="Select a video to set as your desktop background." Style="{ThemeResource BodyTextBlockStyle}" Foreground="Gray" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Video Selection Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button Content="Browse Video" Click="BrowseVideo_Click" Width="140" />
                        <Button x:Name="ApplyButton" Content="Apply Wallpaper" Click="ApplyWallpaper_Click" Style="{ThemeResource AccentButtonStyle}" Width="140" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="No video selected." Foreground="Gray" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Settings Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Settings" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                    
                    <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                        <TextBlock Text="Volume:" VerticalAlignment="Center" Width="80" />
                        <Slider x:Name="VolumeSlider" Width="200" Minimum="0" Maximum="100" Value="0" ValueChanged="VolumeSlider_ValueChanged" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                        <TextBlock Text="Choose a fit:" VerticalAlignment="Center" Width="80" />
                        <ComboBox x:Name="StretchModeComboBox" Width="200" SelectionChanged="StretchModeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Fill (Doldur)" Tag="UniformToFill" />
                            <ComboBoxItem Content="Fit (Sığdır)" Tag="Uniform" />
                            <ComboBoxItem Content="Stretch (Genişlet)" Tag="Fill" />
                            <ComboBoxItem Content="Center (Ortala)" Tag="None" />
                        </ComboBox>
                    </StackPanel>
                    
                    <ToggleSwitch x:Name="StartupToggle" Header="Launch on Windows Startup" Toggled="StartupToggle_Toggled" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
