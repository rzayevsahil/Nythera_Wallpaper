<Window
    x:Class="Nythera.WallpaperWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Nythera"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Nythera Background">
    <Grid Background="Black">
        <MediaPlayerElement x:Name="BackgroundPlayer" 
                            AutoPlay="True" 
                            AreTransportControlsEnabled="False"
                            Stretch="UniformToFill" />
        <!-- Video Effects Overlays -->
        <Rectangle x:Name="ColorOverlay" Fill="Transparent" IsHitTestVisible="False" />
        <Rectangle x:Name="BrightnessOverlay" Fill="Black" Opacity="0" IsHitTestVisible="False" />

        <!-- Interactive Character MVP Overlay -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,100,50" IsHitTestVisible="False">
            <Image x:Name="CharacterImage" Width="300" Height="400" Stretch="Uniform" />
            <TextBlock x:Name="CharacterPlaceholderText" Text="( O_O )" FontSize="72" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
