<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Nythera.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Nythera"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent"
          PointerPressed="RootGrid_PointerPressed"
          PointerMoved="RootGrid_PointerMoved"
          PointerReleased="RootGrid_PointerReleased"
          PointerCanceled="RootGrid_PointerCanceled"
          PointerCaptureLost="RootGrid_PointerCanceled">
          
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Header outside carousel -->
            <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Border CornerRadius="16" HorizontalAlignment="Center">
                    <Image x:Name="AppTitleLogo" Height="140" Stretch="Uniform" />
                </Border>
            </StackPanel>

            <Grid Width="960" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <!-- PAGE 3: About (Starts in background left) -->
            <Grid x:Name="Page3" Width="480" Height="560" VerticalAlignment="Center" HorizontalAlignment="Center" 
                  Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"
                  Opacity="0.4" Canvas.ZIndex="1" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <CompositeTransform TranslateX="-220" ScaleX="0.8" ScaleY="0.8" />
                </Grid.RenderTransform>
                <Border CornerRadius="8" Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel Spacing="16">
                                <TextBlock x:Name="AboutTitleText" Text="Hakkında" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="18" />
                            
                            <!-- App Info Section -->
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="AppInfoTitle" Text="Uygulama Bilgileri" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="ms-appx:///Assets/logo1.png" Width="40" Height="40" Stretch="Uniform" VerticalAlignment="Top" Margin="0,4,16,0" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Nythera" FontWeight="Bold" FontSize="16" />
                                        <TextBlock x:Name="AppVersionText" Text="v1.1.0" Foreground="Gray" FontSize="12" />
                                        <TextBlock x:Name="AboutAppDescText" Text="Sisteminizi yormadan masaüstünüzü yüksek kaliteli ve hareketli videolarla canlandıran, performans odaklı yeni nesil duvar kağıdı motoru." TextWrapping="Wrap" Margin="0,4,0,0" />
                                        
                                        <StackPanel Margin="0,8,0,0" Spacing="4">
                                            <TextBlock x:Name="Feature1Text" Text="• Düşük RAM ve CPU kullanımı" FontSize="12" Foreground="Gray" />
                                            <TextBlock x:Name="Feature2Text" Text="• Akıllı karanlık/aydınlık tema desteği" FontSize="12" Foreground="Gray" />
                                            <TextBlock x:Name="Feature3Text" Text="• Otomatik arka plan güncelleme sistemi" FontSize="12" Foreground="Gray" />
                                            <TextBlock x:Name="Feature4Text" Text="• Tam ekran oyun/uygulama algılama ile otomatik duraklatma" FontSize="12" Foreground="Gray" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <MenuFlyoutSeparator />

                            <!-- Developer Info Section -->
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="DeveloperTitleText" Text="Geliştirici" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Width="96" Height="96" CornerRadius="48" Margin="0,0,16,0" VerticalAlignment="Top">
                                        <Border.Clip>
                                            <RectangleGeometry Rect="0,0,96,96">
                                                <RectangleGeometry.Transform>
                                                    <TranslateTransform />
                                                </RectangleGeometry.Transform>
                                            </RectangleGeometry>
                                        </Border.Clip>
                                        <Image Source="ms-appx:///Assets/developer_image.png" Stretch="UniformToFill" />
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Sahil Rzayev" FontWeight="Bold" FontSize="16" />
                                        <TextBlock x:Name="DeveloperRoleText" Text="Software Developer" Foreground="{ThemeResource SystemAccentColor}" FontSize="13" />
                                        <TextBlock x:Name="DeveloperDescText" Text="Modern masaüstü ve web uygulamaları tasarlayan tutkulu bir yazılım geliştirici." TextWrapping="Wrap" Margin="0,4,0,0" Foreground="Gray" />
                                        
                                        <StackPanel Orientation="Vertical" Spacing="8" Margin="0,12,0,0">
                                            <HyperlinkButton NavigateUri="https://github.com/rzayevsahil" Padding="0">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Data="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                    </Viewbox>
                                                    <TextBlock Text="rzayevsahil" />
                                                </StackPanel>
                                            </HyperlinkButton>
                                            <HyperlinkButton NavigateUri="https://www.linkedin.com/in/sahilrzayev" Padding="0">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Data="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                    </Viewbox>
                                                    <TextBlock Text="sahilrzayev" />
                                                </StackPanel>
                                            </HyperlinkButton>
                                            <HyperlinkButton NavigateUri="mailto:sahilrzayev200d@gmail.com" Padding="0">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Data="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L12 8.414l8.073-4.921c1.618-1.214 3.927-.059 3.927 1.964z" Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                    </Viewbox>
                                                    <TextBlock Text="sahilrzayev200d@gmail.com" />
                                                </StackPanel>
                                            </HyperlinkButton>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <!-- Blur Overlay -->
                <Border x:Name="Page3BlurOverlay" CornerRadius="12" IsHitTestVisible="False" Opacity="0.6">
                    <Border.Background>
                        <AcrylicBrush TintColor="Black" TintOpacity="0.4" FallbackColor="Transparent" />
                    </Border.Background>
                </Border>
            </Grid>

            <!-- PAGE 1: Video Selection (Starts active center) -->
            <Grid x:Name="Page1" Width="480" Height="560" VerticalAlignment="Center" HorizontalAlignment="Center" 
                  Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"
                  Opacity="1.0" Canvas.ZIndex="2" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="True">
                <Grid.RenderTransform>
                    <CompositeTransform TranslateX="0" ScaleX="1.0" ScaleY="1.0" />
                </Grid.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel Spacing="24" Padding="24">
                        <!-- Update Banner (top of page, visible immediately) -->
                        <Border x:Name="UpdateContainer" Visibility="Collapsed" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                                BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="1" 
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                    <TextBlock x:Name="UpdateStatusText" Text="Yeni bir güncelleme mevcut!" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="DownloadUpdateButton"
                                        Grid.Column="1"
                                        Click="DownloadUpdateButton_Click"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="0"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        MinWidth="130">
                                    <Grid Height="32" HorizontalAlignment="Stretch">
                                        <!-- Progress Bar -->
                                        <Rectangle x:Name="DownloadProgressFill"
                                                   HorizontalAlignment="Left"
                                                   Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                   Opacity="0.2"
                                                   Width="0"
                                                   RadiusX="4" RadiusY="4" />
                                        <TextBlock x:Name="DownloadButtonText"
                                                   Text="İndir ve Güncelle"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="AppDescription" Text="Select a video to set as your desktop background." Style="{ThemeResource BodyTextBlockStyle}" Foreground="Gray" HorizontalAlignment="Center" Margin="0,8,0,0" />

                        <!-- Video Selection Card -->
                        <Border CornerRadius="8" Padding="0">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="DefaultVideosTitle" Text="Videolar" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock x:Name="PlaylistModeTitle" Text="Slayt Modu:" FontSize="12" VerticalAlignment="Center" Foreground="Gray" />
                                                <ToggleSwitch x:Name="PlaylistModeToggle" OffContent="Kapalı" OnContent="Açık" Toggled="PlaylistModeToggle_Toggled" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                                            </StackPanel>
                                            <ComboBox x:Name="VideoFilterComboBox" SelectedIndex="0" SelectionChanged="VideoFilterComboBox_SelectionChanged" Width="120" VerticalAlignment="Center">
                                                <ComboBoxItem Content="Tümü" Tag="All" />
                                                <ComboBoxItem Content="Favoriler" Tag="Favorites" />
                                                <ComboBoxItem Content="Eklenenler" Tag="Custom" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <GridView x:Name="DefaultVideosGrid" SelectionMode="Single" SelectionChanged="DefaultVideosGrid_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled" MaxHeight="220" Padding="0,0,0,12" HorizontalAlignment="Stretch">
                                        <GridView.ItemContainerStyle>
                                            <Style TargetType="GridViewItem">
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="Padding" Value="0,0,8,8" />
                                                <Setter Property="MinHeight" Value="0" />
                                                <Setter Property="MinWidth" Value="0" />
                                            </Style>
                                        </GridView.ItemContainerStyle>
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="local:DefaultVideo">
                                                <Grid Width="130" Height="68" CornerRadius="6" Background="#1AFFFFFF">
                                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                                                    
                                                    <!-- Favorite Button -->
                                                    <Button Background="#66000000" Padding="4" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4" CornerRadius="16" Click="FavoriteButton_Click" Tag="{x:Bind VideoPath}">
                                                        <FontIcon Glyph="{x:Bind FavoriteIcon, Mode=OneWay}" FontSize="12" Foreground="White" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                    </Button>

                                                    <!-- Applied Indicator -->
                                                    <Border Background="{ThemeResource SystemAccentColor}" Visibility="{x:Bind IsApplied, Mode=OneWay}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4" Padding="6,2" CornerRadius="4">
                                                        <TextBlock Text="{x:Bind AppliedMonitorsText, Mode=OneWay}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                    </Border>

                                                    <Border Background="#99000000" VerticalAlignment="Bottom">
                                                        <TextBlock Text="{x:Bind Title}" Foreground="White" FontSize="11" Margin="6,4" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>

                                    <!-- Playlist Settings Panel -->
                                    <Border x:Name="PlaylistSettingsPanel" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="16" Margin="0,-8,0,8">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Spacing="4">
                                                <TextBlock x:Name="PlaylistIntervalTitle" Text="Değişim Süresi" FontSize="12" Foreground="Gray" />
                                                <ComboBox x:Name="PlaylistIntervalComboBox" SelectedIndex="2" Width="120">
                                                    <ComboBoxItem x:Name="Interval1m" Content="1 Dakika" Tag="1" />
                                                    <ComboBoxItem x:Name="Interval5m" Content="5 Dakika" Tag="5" />
                                                    <ComboBoxItem x:Name="Interval15m" Content="15 Dakika" Tag="15" />
                                                    <ComboBoxItem x:Name="Interval30m" Content="30 Dakika" Tag="30" />
                                                    <ComboBoxItem x:Name="Interval1h" Content="1 Saat" Tag="60" />
                                                    <ComboBoxItem x:Name="Interval3h" Content="3 Saat" Tag="180" />
                                                    <ComboBoxItem x:Name="Interval6h" Content="6 Saat" Tag="360" />
                                                    <ComboBoxItem x:Name="Interval12h" Content="12 Saat" Tag="720" />
                                                    <ComboBoxItem x:Name="Interval24h" Content="24 Saat" Tag="1440" />
                                                </ComboBox>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock x:Name="PlaylistOrderTitle" Text="Çalma Sırası" FontSize="12" Foreground="Gray" />
                                                <ComboBox x:Name="PlaylistOrderComboBox" SelectedIndex="0" Width="120">
                                                    <ComboBoxItem x:Name="OrderSequential" Content="Sırasıyla" Tag="Sequential" />
                                                    <ComboBoxItem x:Name="OrderRandom" Content="Rastgele" Tag="Random" />
                                                </ComboBox>
                                            </StackPanel>
                                            
                                            <Button x:Name="ApplyPlaylistButton" Grid.Column="2" Content="Uygula" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Click="ApplyPlaylistButton_Click" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Height="1" Fill="Gray" Opacity="0.3" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="VEYA" Foreground="Gray" FontSize="11" Margin="12,0" VerticalAlignment="Center" />
                                    <Rectangle Grid.Column="2" Height="1" Fill="Gray" Opacity="0.3" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <Button x:Name="BrowseVideoButton" Content="Kendi Videonu Seç" Click="BrowseVideo_Click" Width="160" />
                                    <Button x:Name="ApplyButton" Content="Apply Wallpaper" Click="ApplyWallpaper_Click" Style="{ThemeResource AccentButtonStyle}" Width="160" IsEnabled="False" />
                                </StackPanel>
                                <TextBlock x:Name="StatusText" Text="No video selected." Foreground="Gray" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                                
                                <Grid RowSpacing="12" ColumnSpacing="20" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Volume -->
                                    <TextBlock x:Name="VolumeText" Text="Volume:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" />
                                    <Slider x:Name="VolumeSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="0" ValueChanged="VolumeSlider_ValueChanged" />

                                    <!-- Speed -->
                                    <TextBlock x:Name="SpeedText" Text="Oynatma Hızı:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" />
                                    <ComboBox x:Name="SpeedComboBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="SpeedComboBox_SelectionChanged">
                                        <ComboBoxItem x:Name="Speed05" Content="0.5x" Tag="0.5" />
                                        <ComboBoxItem x:Name="Speed075" Content="0.75x" Tag="0.75" />
                                        <ComboBoxItem x:Name="Speed10" Content="1.0x (Normal)" Tag="1.0" />
                                        <ComboBoxItem x:Name="Speed125" Content="1.25x" Tag="1.25" />
                                        <ComboBoxItem x:Name="Speed15" Content="1.5x" Tag="1.5" />
                                        <ComboBoxItem x:Name="Speed20" Content="2.0x" Tag="2.0" />
                                    </ComboBox>

                                    <!-- Brightness -->
                                    <TextBlock x:Name="BrightnessText" Text="Parlaklık:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" />
                                    <Slider x:Name="BrightnessSlider" Grid.Row="2" Grid.Column="1" Minimum="10" Maximum="100" Value="100" ValueChanged="BrightnessSlider_ValueChanged" />

                                    <!-- Video Filter -->
                                    <TextBlock x:Name="ColorOverlayText" Text="Renk Filtresi:" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" />
                                    <ComboBox x:Name="ColorOverlayComboBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="ColorOverlayComboBox_SelectionChanged">
                                        <ComboBoxItem x:Name="FilterNone" Content="Yok" Tag="None" />
                                        <ComboBoxItem x:Name="FilterWarm" Content="Sıcak" Tag="Warm" />
                                        <ComboBoxItem x:Name="FilterCool" Content="Soğuk" Tag="Cool" />
                                        <ComboBoxItem x:Name="FilterMatrix" Content="Matrix (Yeşil)" Tag="Matrix" />
                                        <ComboBoxItem x:Name="FilterCyberpunk" Content="Cyberpunk" Tag="Cyberpunk" />
                                    </ComboBox>

                                    <!-- Stretch Mode -->
                                    <TextBlock x:Name="ChooseFitText" Text="Choose a fit:" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" />
                                    <ComboBox x:Name="StretchModeComboBox" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="StretchModeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Fill (Doldur)" Tag="UniformToFill" />
                                        <ComboBoxItem Content="Fit (Sığdır)" Tag="Uniform" />
                                        <ComboBoxItem Content="Stretch (Genişlet)" Tag="Fill" />
                                        <ComboBoxItem Content="Center (Ortala)" Tag="None" />
                                    </ComboBox>
                                    
                                    <!-- Target Monitor -->
                                    <TextBlock x:Name="TargetMonitorText" Text="Monitor:" VerticalAlignment="Center" Grid.Row="5" Grid.Column="0" />
                                    <ComboBox x:Name="TargetMonitorComboBox" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="TargetMonitorComboBox_SelectionChanged">
                                    </ComboBox>
                                </Grid>
                                
                                <!-- Video Preview -->
                                <Border x:Name="PreviewBorder" CornerRadius="8" Margin="0,8,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="Black" Height="243">
                                    <Grid CornerRadius="8">
                                        <Viewbox Stretch="Uniform">
                                            <Grid x:Name="VirtualDesktopGrid" Width="1920" Height="1080" Background="Transparent">
                                                <MediaPlayerElement x:Name="PreviewPlayer" AutoPlay="True" AreTransportControlsEnabled="False" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                <!-- Preview Overlays -->
                                                <Rectangle x:Name="PreviewColorOverlay" Fill="Transparent" IsHitTestVisible="False" />
                                                <Rectangle x:Name="PreviewBrightnessOverlay" Fill="Black" Opacity="0" IsHitTestVisible="False" />
                                            </Grid>
                                        </Viewbox>
                                        <FontIcon x:Name="PreviewPlaceholderIcon" Glyph="&#xE714;" FontSize="48" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        
                                        <Border x:Name="AppliedBadge" Visibility="Collapsed" Background="{ThemeResource SystemAccentColor}" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="6,4">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="White" />
                                                <TextBlock x:Name="AppliedBadgeText" Text="Uygulandı" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="PreviewInfoText" Text="Önizleme: Ana Ekran" Foreground="Gray" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>



                    </StackPanel>
                </ScrollViewer>
                <!-- Blur Overlay -->
                <Border x:Name="Page1BlurOverlay" CornerRadius="12" IsHitTestVisible="False" Opacity="0.0">
                    <Border.Background>
                        <AcrylicBrush TintColor="Black" TintOpacity="0.4" FallbackColor="Transparent" />
                    </Border.Background>
                </Border>
            </Grid>

            <!-- PAGE 2: Settings (Starts in background right) -->
            <Grid x:Name="Page2" Width="480" Height="560" VerticalAlignment="Center" HorizontalAlignment="Center" 
                  Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"
                  Opacity="0.4" Canvas.ZIndex="1" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <CompositeTransform TranslateX="220" ScaleX="0.8" ScaleY="0.8" />
                </Grid.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel Spacing="24" Padding="24">
                        
                        <!-- Settings Card -->
                        <Border CornerRadius="8" Padding="0">
                            <StackPanel Spacing="16">
                                <TextBlock x:Name="SettingsTitle" Text="Settings" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                                
                                <Grid RowSpacing="12" ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Theme -->
                                    <TextBlock x:Name="ThemeText" Text="Theme:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" />
                                    <ComboBox x:Name="ThemeComboBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="ThemeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Dark" Tag="Dark" />
                                        <ComboBoxItem Content="Light" Tag="Light" />
                                        <ComboBoxItem Content="System" Tag="Default" />
                                    </ComboBox>

                                    <!-- Language -->
                                    <TextBlock x:Name="LanguageText" Text="Language:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" />
                                    <ComboBox x:Name="LanguageComboBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="LanguageComboBox_SelectionChanged">
                                        <ComboBoxItem Content="English" Tag="en" />
                                        <ComboBoxItem Content="Türkçe" Tag="tr" />
                                    </ComboBox>
                                </Grid>
                                
                                <ToggleSwitch x:Name="StartupToggle" Header="Launch on Windows Startup" Toggled="StartupToggle_Toggled" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
                <!-- Blur Overlay -->
                <Border x:Name="Page2BlurOverlay" CornerRadius="12" IsHitTestVisible="False" Opacity="0.6">
                    <Border.Background>
                        <AcrylicBrush TintColor="Black" TintOpacity="0.4" FallbackColor="Transparent" />
                    </Border.Background>
                </Border>
            </Grid>
            
        </Grid>
        
        <PipsPager x:Name="CarouselPager" NumberOfPages="3" SelectedPageIndex="0" WrapMode="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,32,0,0"
                   SelectedIndexChanged="CarouselPager_SelectedIndexChanged" />
            </StackPanel>
        </Viewbox>
    </Grid>
</Page>
