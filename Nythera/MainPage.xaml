<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Nythera.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Nythera"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent"
          PointerPressed="RootGrid_PointerPressed"
          PointerMoved="RootGrid_PointerMoved"
          PointerReleased="RootGrid_PointerReleased"
          PointerCanceled="RootGrid_PointerCanceled"
          PointerCaptureLost="RootGrid_PointerCanceled">
          
        <Viewbox Stretch="Uniform" StretchDirection="Both">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Header outside carousel -->
            <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Border CornerRadius="16" HorizontalAlignment="Center">
                <Image x:Name="AppTitleLogo" Height="140" Stretch="Uniform" />
                </Border>
            </StackPanel>

            <Grid Width="1080" Height="680" HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <!-- PAGE 4: About -->
            <Grid x:Name="PageAbout" Width="560" Height="680" VerticalAlignment="Center" HorizontalAlignment="Center" 
                  Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"
                  Opacity="0.4" Canvas.ZIndex="4" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <CompositeTransform TranslateX="-260" ScaleX="0.8" ScaleY="0.8" />
                </Grid.RenderTransform>
                <Border x:Name="PageAboutContent" CornerRadius="8" Padding="24" Opacity="0.05">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel Spacing="16">
                                <TextBlock x:Name="AboutTitleText" Text="Hakkında" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="18" />
                            
                            <!-- App Info Section -->
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="AppInfoTitle" Text="Uygulama Bilgileri" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="ms-appx:///Assets/logo1.png" Width="40" Height="40" Stretch="Uniform" VerticalAlignment="Top" Margin="0,4,16,0" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Nythera" FontWeight="Bold" FontSize="16" />
                                        <TextBlock x:Name="AppVersionText" Text="v1.1.0" Foreground="Gray" FontSize="12" />
                                        <TextBlock x:Name="AboutAppDescText" Text="Sisteminizi yormadan masaüstünüzü yüksek kaliteli ve hareketli videolarla canlandıran, performans odaklı yeni nesil duvar kağıdı motoru." TextWrapping="Wrap" Margin="0,4,0,0" />
                                        
                                        <StackPanel Margin="0,8,0,0" Spacing="4">
                                            <TextBlock x:Name="Feature1Text" Text="• Düşük RAM ve CPU kullanımı" FontSize="12" Foreground="Gray" />
                                            <TextBlock x:Name="Feature2Text" Text="• Akıllı karanlık/aydınlık tema desteği" FontSize="12" Foreground="Gray" />
                                            <TextBlock x:Name="Feature3Text" Text="• Otomatik arka plan güncelleme sistemi" FontSize="12" Foreground="Gray" />
                                            <TextBlock x:Name="Feature4Text" Text="• Tam ekran oyun/uygulama algılama ile otomatik duraklatma" FontSize="12" Foreground="Gray" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <MenuFlyoutSeparator />

                            <!-- Developer Info Section -->
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="DeveloperTitleText" Text="Geliştirici" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <Grid Width="96" Height="96" Margin="0,0,16,0" VerticalAlignment="Top">
                                        <!-- Fallback Initials -->
                                        <PersonPicture x:Name="DeveloperFallback" DisplayName="Sahil Rzayev" />
                                        <!-- Crisp circular image -->
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="ms-appx:///Assets/developer_image.png" Stretch="UniformToFill" ImageOpened="DeveloperImage_ImageOpened" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                    
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Sahil Rzayev" FontWeight="Bold" FontSize="16" />
                                        <TextBlock x:Name="DeveloperRoleText" Text="Software Developer" Foreground="{ThemeResource SystemAccentColor}" FontSize="13" />
                                        <TextBlock x:Name="DeveloperDescText" Text="Modern masaüstü ve web uygulamaları tasarlayan tutkulu bir yazılım geliştirici." TextWrapping="Wrap" Margin="0,4,0,0" Foreground="Gray" />
                                        
                                        <StackPanel Orientation="Vertical" Spacing="8" Margin="0,12,0,0">
                                            <HyperlinkButton NavigateUri="https://github.com/rzayevsahil" Padding="0">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Data="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                    </Viewbox>
                                                    <TextBlock Text="rzayevsahil" />
                                                </StackPanel>
                                            </HyperlinkButton>
                                            <HyperlinkButton NavigateUri="https://www.linkedin.com/in/sahilrzayev" Padding="0">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Data="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                    </Viewbox>
                                                    <TextBlock Text="sahilrzayev" />
                                                </StackPanel>
                                            </HyperlinkButton>
                                            <HyperlinkButton NavigateUri="mailto:sahilrzayev200d@gmail.com" Padding="0">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Data="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L12 8.414l8.073-4.921c1.618-1.214 3.927-.059 3.927 1.964z" Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                    </Viewbox>
                                                    <TextBlock Text="sahilrzayev200d@gmail.com" />
                                                </StackPanel>
                                            </HyperlinkButton>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- PAGE 0: Image Selection -->
            <Grid x:Name="PageImages" Width="560" Height="680" VerticalAlignment="Center" HorizontalAlignment="Center" 
                  Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"
                  Opacity="1.0" Canvas.ZIndex="5" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="True">
                <Grid.RenderTransform>
                    <CompositeTransform TranslateX="0" ScaleX="1.0" ScaleY="1.0" />
                </Grid.RenderTransform>
                <ScrollViewer x:Name="PageImagesContent" VerticalScrollBarVisibility="Hidden" Opacity="1.0">
                    <StackPanel Spacing="24" Padding="24">
                        <TextBlock x:Name="ImagesDescription" Text="Select an image to set as your desktop background." Style="{ThemeResource BodyTextBlockStyle}" Foreground="Gray" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        
                        <Border CornerRadius="8" Padding="0">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="DefaultImagesTitle" Text="Resimler" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock x:Name="ImagePlaylistModeTitle" Text="Slayt Modu:" FontSize="12" VerticalAlignment="Center" Foreground="Gray" />
                                                <ToggleSwitch x:Name="ImagePlaylistModeToggle" OffContent="Kapalı" OnContent="Açık" Toggled="ImagePlaylistModeToggle_Toggled" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                                            </StackPanel>
                                            <ComboBox x:Name="ImageFilterComboBox" SelectedIndex="0" SelectionChanged="ImageFilterComboBox_SelectionChanged" Width="120" VerticalAlignment="Center">
                                                <ComboBoxItem Content="All" Tag="All" />
                                                <ComboBoxItem Content="Favorites" Tag="Favorites" />
                                                <ComboBoxItem Content="Custom" Tag="Custom" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <GridView x:Name="DefaultImagesGrid" SelectionMode="Single" SelectionChanged="DefaultImagesGrid_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled" MaxHeight="340" Padding="0,0,0,12" HorizontalAlignment="Stretch">
                                        <GridView.Resources>
                                            <SolidColorBrush x:Key="GridViewItemSelectedBorderThemeBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="GridViewItemSelectedPointerOverBorderThemeBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="GridViewItemPointerOverBorderThemeBrush" Color="Transparent" />
                                        </GridView.Resources>
                                        <GridView.ItemContainerStyle>
                                            <Style TargetType="GridViewItem">
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="Padding" Value="0,0,8,8" />
                                                <Setter Property="MinHeight" Value="0" />
                                                <Setter Property="MinWidth" Value="0" />
                                            </Style>
                                        </GridView.ItemContainerStyle>
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="local:Core.WallpaperImage">
                                                <Grid Width="156" Height="82" CornerRadius="6" Background="#1AFFFFFF">
                                                    <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4">
                                                        <!-- Fake Playlist button for UI consistency MVP -->
                                                        <Button Background="#66000000" Width="26" Height="26" Padding="0" CornerRadius="8" Click="ImagePlaylistSelectButton_Click" Tag="{x:Bind ImagePath}">
                                                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="White" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                        </Button>
                                                        <Button Background="#66000000" Width="26" Height="26" Padding="0" CornerRadius="13" Click="ImageFavoriteButton_Click" Tag="{x:Bind ImagePath}">
                                                            <FontIcon Glyph="&#xE734;" FontSize="12" Foreground="White" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                        </Button>
                                                    </StackPanel>
                                                    <Border Background="#99000000" VerticalAlignment="Bottom">
                                                        <TextBlock Text="{x:Bind Name}" Foreground="White" FontSize="11" Margin="6,4" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </StackPanel>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Height="1" Fill="Gray" Opacity="0.3" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ImageOrText" Grid.Column="1" Text="VEYA" Foreground="Gray" FontSize="11" Margin="12,0" VerticalAlignment="Center" />
                                    <Rectangle Grid.Column="2" Height="1" Fill="Gray" Opacity="0.3" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <Button x:Name="BrowseImageButton" Content="Kendi Resmini Seç" Click="BrowseImage_Click" Width="160" />
                                    <Button x:Name="ApplyImageButton" Content="Apply Wallpaper" Click="ApplyImage_Click" Style="{ThemeResource AccentButtonStyle}" Width="160" IsEnabled="False" />
                                </StackPanel>
                                <TextBlock x:Name="ImageStatusText" Text="No image selected." Foreground="Gray" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                                
                                <Grid RowSpacing="12" ColumnSpacing="20" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Blur -->
                                    <TextBlock x:Name="ImageBlurTitle" Text="Blur:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" />
                                    <Slider x:Name="ImageBlurSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="20" Value="0" ValueChanged="ImageProperties_ValueChanged" />

                                    <!-- Brightness -->
                                    <TextBlock x:Name="ImageBrightnessTitle" Text="Parlaklık:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" />
                                    <Slider x:Name="ImageBrightnessSlider" Grid.Row="1" Grid.Column="1" Minimum="10" Maximum="150" Value="100" ValueChanged="ImageProperties_ValueChanged" />

                                    <!-- Contrast -->
                                    <TextBlock x:Name="ImageContrastTitle" Text="Kontrast:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" />
                                    <Slider x:Name="ImageContrastSlider" Grid.Row="2" Grid.Column="1" Minimum="10" Maximum="200" Value="100" ValueChanged="ImageProperties_ValueChanged" />

                                    <!-- Stretch Mode -->
                                    <TextBlock x:Name="ImageStretchTitle" Text="Yerleşim:" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" />
                                    <ComboBox x:Name="ImageStretchComboBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="ImageStretchComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Fill" Tag="Fill" />
                                        <ComboBoxItem Content="Fit" Tag="Fit" />
                                        <ComboBoxItem Content="Stretch" Tag="Stretch" />
                                        <ComboBoxItem Content="Center" Tag="Center" />
                                        <ComboBoxItem Content="Span (Çoklu Ekran)" Tag="Span" />
                                    </ComboBox>
                                    
                                    <!-- Effects Toggles -->
                                    <TextBlock x:Name="ImageEffectsTitle" Text="Efektler:" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" />
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                                        <ToggleSwitch x:Name="KenBurnsToggle" OffContent="Ken Burns" OnContent="Ken Burns" Toggled="ImageProperties_ValueChanged" />
                                        <ToggleSwitch x:Name="ParallaxToggle" OffContent="Parallax" OnContent="Parallax" Toggled="ImageProperties_ValueChanged" />
                                    </StackPanel>
                                    
                                    <!-- Target Monitor -->
                                    <TextBlock x:Name="ImageMonitorTitle" Text="Monitor:" VerticalAlignment="Center" Grid.Row="5" Grid.Column="0" />
                                    <ComboBox x:Name="ImageMonitorComboBox" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="ImageMonitorComboBox_SelectionChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <!-- PAGE 1: Video Selection (Starts active center) -->
            <Grid x:Name="PageVideos" Width="560" Height="680" VerticalAlignment="Center" HorizontalAlignment="Center" 
                  Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"
                  Opacity="0.4" Canvas.ZIndex="4" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <CompositeTransform TranslateX="260" ScaleX="0.8" ScaleY="0.8" />
                </Grid.RenderTransform>
                <ScrollViewer x:Name="PageVideosContent" VerticalScrollBarVisibility="Hidden" Opacity="0.05">
                    <StackPanel Spacing="24" Padding="24">
                        <!-- Update Banner (top of page, visible immediately) -->
                        <Border x:Name="UpdateContainer" Visibility="Collapsed" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                                BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="1" 
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                    <TextBlock x:Name="UpdateStatusText" Text="Yeni bir güncelleme mevcut!" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="DownloadUpdateButton"
                                        Grid.Column="1"
                                        Click="DownloadUpdateButton_Click"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="0"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        MinWidth="130">
                                    <Grid Height="32" HorizontalAlignment="Stretch">
                                        <!-- Progress Bar -->
                                        <Rectangle x:Name="DownloadProgressFill"
                                                   HorizontalAlignment="Left"
                                                   Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                   Opacity="0.2"
                                                   Width="0"
                                                   RadiusX="4" RadiusY="4" />
                                        <TextBlock x:Name="DownloadButtonText"
                                                   Text="İndir ve Güncelle"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="AppDescription" Text="Select a video to set as your desktop background." Style="{ThemeResource BodyTextBlockStyle}" Foreground="Gray" HorizontalAlignment="Center" Margin="0,8,0,0" />

                        <!-- Video Selection Card -->
                        <Border CornerRadius="8" Padding="0">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="DefaultVideosTitle" Text="Videolar" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock x:Name="PlaylistModeTitle" Text="Slayt Modu:" FontSize="12" VerticalAlignment="Center" Foreground="Gray" />
                                                <ToggleSwitch x:Name="PlaylistModeToggle" OffContent="Kapalı" OnContent="Açık" Toggled="PlaylistModeToggle_Toggled" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                                            </StackPanel>
                                            <ComboBox x:Name="VideoFilterComboBox" SelectedIndex="0" SelectionChanged="VideoFilterComboBox_SelectionChanged" Width="120" VerticalAlignment="Center">
                                                <ComboBoxItem Content="All" Tag="All" />
                                                <ComboBoxItem Content="Favorites" Tag="Favorites" />
                                                <ComboBoxItem Content="Custom" Tag="Custom" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <GridView x:Name="DefaultVideosGrid" SelectionMode="Single" SelectionChanged="DefaultVideosGrid_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled" MaxHeight="340" Padding="0,0,0,12" HorizontalAlignment="Stretch">
                                        <GridView.Resources>
                                            <!-- Hide the native WinUI 3 Selection Borders to make our custom blue line pop -->
                                            <SolidColorBrush x:Key="GridViewItemSelectedBorderThemeBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="GridViewItemSelectedPointerOverBorderThemeBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="GridViewItemPointerOverBorderThemeBrush" Color="Transparent" />
                                        </GridView.Resources>
                                        <GridView.ItemContainerStyle>
                                            <Style TargetType="GridViewItem">
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="Padding" Value="0,0,8,8" />
                                                <Setter Property="MinHeight" Value="0" />
                                                <Setter Property="MinWidth" Value="0" />
                                            </Style>
                                        </GridView.ItemContainerStyle>
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="local:DefaultVideo">
                                                <Grid Width="156" Height="82" CornerRadius="6" Background="#1AFFFFFF">
                                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                                                    
                                                    <!-- Custom Single Selection Indicator (Sleek Gradient) -->
                                                    <Border Width="4" HorizontalAlignment="Left" VerticalAlignment="Stretch" CornerRadius="6,0,0,6" Visibility="{x:Bind SelectionIndicatorVisibility, Mode=OneWay}">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="White" Offset="0.0" />
                                                                <GradientStop Color="#33FFFFFF" Offset="1.0" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4">
                                                        <!-- Custom Playlist Selection Checkbox -->
                                                        <Button Background="#66000000" Width="26" Height="26" Padding="0" CornerRadius="8" Click="PlaylistSelectButton_Click" Tag="{x:Bind VideoPath}" Visibility="{x:Bind PlaylistSelectionVisibility, Mode=OneWay}">
                                                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="White" Visibility="{x:Bind PlaylistCheckVisibility, Mode=OneWay}" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                        </Button>

                                                        <!-- Delete Button (Only for Custom) -->
                                                        <Button Background="#66000000" Width="26" Height="26" Padding="0" CornerRadius="13" Click="DeleteButton_Click" Tag="{x:Bind VideoPath}" Visibility="{x:Bind DeleteButtonVisibility, Mode=OneWay}">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="White" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                        </Button>

                                                        <!-- Favorite Button (Static, never moves) -->
                                                        <Button Background="#66000000" Width="26" Height="26" Padding="0" CornerRadius="13" Click="FavoriteButton_Click" Tag="{x:Bind VideoPath}">
                                                            <FontIcon Glyph="{x:Bind FavoriteIcon, Mode=OneWay}" FontSize="12" Foreground="White" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                        </Button>
                                                    </StackPanel>

                                                    <!-- Applied Indicator -->
                                                    <Border Background="{ThemeResource SystemAccentColor}" Visibility="{x:Bind IsApplied, Mode=OneWay}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4" Padding="6,2" CornerRadius="4">
                                                        <TextBlock Text="{x:Bind AppliedMonitorsText, Mode=OneWay}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                    </Border>

                                                    <Border Background="#99000000" VerticalAlignment="Bottom">
                                                        <TextBlock Text="{x:Bind Title}" Foreground="White" FontSize="11" Margin="6,4" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>

                                    <!-- Playlist Settings Panel -->
                                    <Border x:Name="PlaylistSettingsPanel" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="16" Margin="0,-8,0,8">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Spacing="4">
                                                <TextBlock x:Name="PlaylistIntervalTitle" Text="Değişim Süresi" FontSize="12" Foreground="Gray" />
                                                <ComboBox x:Name="PlaylistIntervalComboBox" SelectedIndex="2" Width="120">
                                                    <ComboBoxItem x:Name="Interval1m" Content="1 Dakika" Tag="1" />
                                                    <ComboBoxItem x:Name="Interval5m" Content="5 Dakika" Tag="5" />
                                                    <ComboBoxItem x:Name="Interval15m" Content="15 Dakika" Tag="15" />
                                                    <ComboBoxItem x:Name="Interval30m" Content="30 Dakika" Tag="30" />
                                                    <ComboBoxItem x:Name="Interval1h" Content="1 Saat" Tag="60" />
                                                    <ComboBoxItem x:Name="Interval3h" Content="3 Saat" Tag="180" />
                                                    <ComboBoxItem x:Name="Interval6h" Content="6 Saat" Tag="360" />
                                                    <ComboBoxItem x:Name="Interval12h" Content="12 Saat" Tag="720" />
                                                    <ComboBoxItem x:Name="Interval24h" Content="24 Saat" Tag="1440" />
                                                </ComboBox>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock x:Name="PlaylistOrderTitle" Text="Çalma Sırası" FontSize="12" Foreground="Gray" />
                                                <ComboBox x:Name="PlaylistOrderComboBox" SelectedIndex="0" Width="120">
                                                    <ComboBoxItem x:Name="OrderSequential" Content="Sırasıyla" Tag="Sequential" />
                                                    <ComboBoxItem x:Name="OrderRandom" Content="Rastgele" Tag="Random" />
                                                </ComboBox>
                                            </StackPanel>
                                            
                                            <Button x:Name="ApplyPlaylistButton" Grid.Column="2" Content="Uygula" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Click="ApplyPlaylistButton_Click" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Height="1" Fill="Gray" Opacity="0.3" VerticalAlignment="Center" />
                                    <TextBlock x:Name="OrDividerText" Grid.Column="1" Text="VEYA" Foreground="Gray" FontSize="11" Margin="12,0" VerticalAlignment="Center" />
                                    <Rectangle Grid.Column="2" Height="1" Fill="Gray" Opacity="0.3" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <Button x:Name="BrowseVideoButton" Content="Kendi Videonu Seç" Click="BrowseVideo_Click" Width="160" />
                                    <Button x:Name="ApplyButton" Content="Apply Wallpaper" Click="ApplyWallpaper_Click" Style="{ThemeResource AccentButtonStyle}" Width="160" IsEnabled="False" />
                                </StackPanel>
                                <TextBlock x:Name="StatusText" Text="No video selected." Foreground="Gray" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                                
                                <Grid RowSpacing="12" ColumnSpacing="20" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Volume -->
                                    <TextBlock x:Name="VolumeText" Text="Volume:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" />
                                    <Slider x:Name="VolumeSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="0" ValueChanged="VolumeSlider_ValueChanged" />

                                    <!-- Speed -->
                                    <TextBlock x:Name="SpeedText" Text="Oynatma Hızı:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" />
                                    <ComboBox x:Name="SpeedComboBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="SpeedComboBox_SelectionChanged">
                                        <ComboBoxItem x:Name="Speed05" Content="0.5x" Tag="0.5" />
                                        <ComboBoxItem x:Name="Speed075" Content="0.75x" Tag="0.75" />
                                        <ComboBoxItem x:Name="Speed10" Content="1.0x (Normal)" Tag="1.0" />
                                        <ComboBoxItem x:Name="Speed125" Content="1.25x" Tag="1.25" />
                                        <ComboBoxItem x:Name="Speed15" Content="1.5x" Tag="1.5" />
                                        <ComboBoxItem x:Name="Speed20" Content="2.0x" Tag="2.0" />
                                    </ComboBox>

                                    <!-- Brightness -->
                                    <TextBlock x:Name="BrightnessText" Text="Parlaklık:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" />
                                    <Slider x:Name="BrightnessSlider" Grid.Row="2" Grid.Column="1" Minimum="10" Maximum="100" Value="100" ValueChanged="BrightnessSlider_ValueChanged" />

                                    <!-- Video Filter -->
                                    <TextBlock x:Name="ColorOverlayText" Text="Renk Filtresi:" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" />
                                    <ComboBox x:Name="ColorOverlayComboBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="ColorOverlayComboBox_SelectionChanged">
                                        <ComboBoxItem x:Name="FilterNone" Content="Yok" Tag="None" />
                                        <ComboBoxItem x:Name="FilterWarm" Content="Sıcak" Tag="Warm" />
                                        <ComboBoxItem x:Name="FilterCool" Content="Soğuk" Tag="Cool" />
                                        <ComboBoxItem x:Name="FilterMatrix" Content="Matrix (Yeşil)" Tag="Matrix" />
                                        <ComboBoxItem x:Name="FilterCyberpunk" Content="Cyberpunk" Tag="Cyberpunk" />
                                    </ComboBox>

                                    <!-- Stretch Mode -->
                                    <TextBlock x:Name="ChooseFitText" Text="Choose a fit:" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" />
                                    <ComboBox x:Name="StretchModeComboBox" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="StretchModeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Fill" Tag="UniformToFill" />
                                        <ComboBoxItem Content="Fit" Tag="Uniform" />
                                        <ComboBoxItem Content="Stretch" Tag="Fill" />
                                        <ComboBoxItem Content="Center" Tag="None" />
                                    </ComboBox>
                                    
                                    <!-- Target Monitor -->
                                    <TextBlock x:Name="TargetMonitorText" Text="Monitor:" VerticalAlignment="Center" Grid.Row="5" Grid.Column="0" />
                                    <ComboBox x:Name="TargetMonitorComboBox" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="TargetMonitorComboBox_SelectionChanged">
                                    </ComboBox>
                                </Grid>
                                
                                <!-- Video Preview -->
                                <Border x:Name="PreviewBorder" CornerRadius="8" Margin="0,8,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="Black">
                                    <Grid CornerRadius="8">
                                        <Viewbox Stretch="Uniform">
                                            <Grid x:Name="VirtualDesktopGrid" Width="1920" Height="1080" Background="Transparent">
                                                <MediaPlayerElement x:Name="PreviewPlayer" AutoPlay="True" AreTransportControlsEnabled="False" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                <!-- Preview Overlays -->
                                                <Rectangle x:Name="PreviewColorOverlay" Fill="Transparent" IsHitTestVisible="False" />
                                                <Rectangle x:Name="PreviewBrightnessOverlay" Fill="Black" Opacity="0" IsHitTestVisible="False" />
                                            </Grid>
                                        </Viewbox>
                                        <FontIcon x:Name="PreviewPlaceholderIcon" Glyph="&#xE714;" FontSize="48" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        
                                        <Border x:Name="AppliedBadge" Visibility="Collapsed" Background="{ThemeResource SystemAccentColor}" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="6,4">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="White" />
                                                <TextBlock x:Name="AppliedBadgeText" Text="Uygulandı" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="PreviewInfoText" Text="Önizleme: Ana Ekran" Foreground="Gray" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>



                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- PAGE 3: Settings -->
            <Grid x:Name="PageSettings" Width="560" Height="680" VerticalAlignment="Center" HorizontalAlignment="Center" 
                  Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"
                  Opacity="0.0" Canvas.ZIndex="3" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <CompositeTransform TranslateX="-520" ScaleX="0.6" ScaleY="0.6" />
                </Grid.RenderTransform>
                <ScrollViewer x:Name="PageSettingsContent" VerticalScrollBarVisibility="Hidden" Opacity="0.05">
                    <StackPanel Spacing="24" Padding="24">
                        
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="SettingsTitle" Text="Settings" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            
                            <!-- General -->
                            <Expander x:Name="GeneralExpander" Header="Genel (General)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                                <StackPanel Spacing="16">
                                    <Grid RowSpacing="12" ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="ThemeText" Text="Tema:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" />
                                        <ComboBox x:Name="ThemeComboBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="ThemeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Dark" Tag="Dark" />
                                            <ComboBoxItem Content="Light" Tag="Light" />
                                            <ComboBoxItem Content="System" Tag="Default" />
                                        </ComboBox>

                                        <TextBlock x:Name="LanguageText" Text="Dil:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" />
                                        <ComboBox x:Name="LanguageComboBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="LanguageComboBox_SelectionChanged">
                                            <ComboBoxItem Content="English" Tag="en" />
                                            <ComboBoxItem Content="Türkçe" Tag="tr" />
                                        </ComboBox>
                                    </Grid>
                                    <ToggleSwitch x:Name="StartupToggle" Header="Windows ile başlat" Toggled="StartupToggle_Toggled" />
                                </StackPanel>
                            </Expander>

                            <!-- Performance -->
                            <Expander x:Name="PerformanceExpander" Header="Performans (Performance)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="16">

                                    <StackPanel Spacing="2">
                                        <ToggleSwitch x:Name="BatterySaverToggle" Header="Pildeyken duraklat (Battery Saver)" IsOn="True" Toggled="BatterySaverToggle_Toggled" />
                                        <TextBlock x:Name="BatterySaverDescText" Text="Pil %20'nin altına düştüğünde sistemi rahatlatmak için duvar kağıdını otomatik duraklatır." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <!-- Gaming -->
                            <Expander x:Name="GamingExpander" Header="Oyun Modu (Gaming)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="2">
                                        <ToggleSwitch x:Name="PauseFullscreenToggle" Header="Tam ekran uygulamalarda duraklat" IsOn="True" Toggled="PauseFullscreenToggle_Toggled" />
                                        <TextBlock x:Name="PauseFullscreenDescText" Text="Tam ekran bir oyun veya uygulama açtığınızda performansınızı korumak için duvar kağıdını duraklatır." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- PAGE 2: Marketplace -->
            <Grid x:Name="PageMarketplace" Width="560" Height="680" VerticalAlignment="Center" HorizontalAlignment="Center" 
                  Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"
                  Opacity="0.0" Canvas.ZIndex="3" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False" Visibility="Visible">
                <Grid.RenderTransform>
                    <CompositeTransform TranslateX="520" ScaleX="0.6" ScaleY="0.6" />
                </Grid.RenderTransform>
                <Border x:Name="PageMarketplaceContent" CornerRadius="8" Padding="24" Opacity="0.05">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        
                        <TextBlock x:Name="MarketplaceTitleText" Text="Keşfet (Marketplace)" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" Margin="0,0,0,16" />
                        
                        <ProgressRing x:Name="MarketplaceLoadingRing" IsActive="True" Width="40" Height="40" Grid.Row="1" />
                        
                        <GridView x:Name="MarketplaceGrid" Grid.Row="1" SelectionMode="None">
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="224" Height="130" CornerRadius="8" Background="#1AFFFFFF" Margin="0,0,12,12">
                                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                        <Border Background="#99000000" VerticalAlignment="Bottom" Padding="8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Author}" Foreground="LightGray" FontSize="10" />
                                                <Button Content="{Binding DownloadStateText}" IsEnabled="{Binding CanDownload}" Click="MarketplaceDownload_Click" Tag="{Binding Id}" Margin="0,4,0,0" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" Padding="4" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>
                </Border>
            </Grid>
            
        </Grid>
        
        <PipsPager x:Name="CarouselPager" NumberOfPages="5" SelectedPageIndex="0" WrapMode="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,32,0,0"
                   SelectedIndexChanged="CarouselPager_SelectedIndexChanged" />
            </StackPanel>
        </Viewbox>
    </Grid>
</Page>


